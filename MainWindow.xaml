<Window x:Class="Tower_Defense_Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tower_Defense_Game"
        mc:Ignorable="d"
        Title="Tower Defense" Height="720" Width="1100"
        Background="#202225">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Linke Seite: Spielfeld -->
            <ColumnDefinition/>
            <!-- Rechte Seite: HUD / Menü -->
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Spielfeld -->
        <Canvas x:Name="GameCanvas" Margin="12">
            <!--Gradient als Hintergrund mit 3 Blau-Sorten-->
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6FBFF" Offset="0.0"/>
                    <!-- ice blue -->
                    <GradientStop Color="#6EC6FF" Offset="0.5"/>
                    <!-- sky blue -->
                    <GradientStop Color="#00E5FF" Offset="1.0"/>
                    <!-- cyan -->
                </LinearGradientBrush>
            </Canvas.Background>

            <!-- Sichtbarer Weg: weiße Linie + breite "Straße" darunter -->
            <!-- Breite graue Straße -->
            <Polyline Points="{Binding PathPoints}"
              Stroke=" #D4AF37" StrokeThickness="24"
              StrokeLineJoin="Round"/>

            <!-- Weiße gestrichelte Mittellinie -->
            <Polyline Points="{Binding PathPoints}"
              Stroke="#3E8E41" StrokeThickness="2"
              StrokeDashArray="2 3"
              StrokeLineJoin="Round"/>
            <!--    Wegpunkte anzeigen, hilft beim Debuggen -->
            
            <ItemsControl ItemsSource="{Binding PathPoints}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="8" Height="8" Fill="#26619C" Margin="-4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Gegner -->
            <ItemsControl ItemsSource="{Binding Enemies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas></Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <!--Position import per Binding von der X und Y position-->
                        <Setter Property="Canvas.Left" Value="{Binding E_x_pos}" />
                        <Setter Property="Canvas.Top" Value="{Binding E_y_pos}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--Bild import per Source implementation + grösse Anpassung-->
                        <Image Width="48" Height="48" Margin="-24"
           Source="pack://application:,,,/images/Enemy.png"
           RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <!--Rotationsaufruf damit dies Visuell ersichtlich ist-->
                                <RotateTransform Angle="{Binding Rotation}" />
                            </Image.RenderTransform>
                        </Image>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>



        </Canvas>

        <!-- HUD rechts -->
        <StackPanel Grid.Column="1" Background="#1e1e1e">

            <!-- Überschrift -->
            <TextBlock Text="Tower Defense" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="High Tower Text" FontSize="30" Foreground="White" Margin="20,0,0,12"/>

            <!-- Anzeige Lives -->
            <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                <TextBlock Text="Lives: " Foreground="Gainsboro" FontSize="20" FontFamily="High Tower Text"/>
                <!-- Binding: Text zeigt Wert aus GameViewModel.Lives an -->
                <TextBlock Text="{Binding Lives}" Foreground="LightGreen" FontSize="20" FontFamily="High Tower Text" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Anzeige Gold -->
            <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                <TextBlock Text="Gold: " Foreground="Gainsboro" FontSize="20" FontFamily="High Tower Text"/>
                <!-- Binding: Text zeigt Wert aus GameViewModel.Gold an -->
                <TextBlock Text="{Binding Gold}" Foreground="Gold" FontSize="20" FontFamily="High Tower Text" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                <TextBlock Text="Round: " FontSize="20" FontFamily="High Tower Text" Foreground="Gainsboro"/>
                <!-- Binding: Text zeigt Wert aus  an -->
                <TextBlock Text="{Binding CurrentWave}" FontSize="20" Foreground="Violet" FontFamily="High Tower Text" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Content="{Binding ContinueLabel}" Click="Continue_Click" FontSize="20" FontFamily="High Tower Text" Margin="0,10,6,0" Height="30" Width="200"/>

            <Separator Margin="0,12,0,12"/>

            <TextBlock Text="Türme zur Auswahl:" Foreground="LightGray" Margin="0,0,0,4"/>

            <!-- Drei Buttons für Türme -->
            <Button Content="Drone of Doom (50 Gold)" Click="SpawnTower1_Click" Margin="0,2,0,2"/>
            <Button Content="Drone of Demise  (50 Gold)" Click="SpawnTower2_Click" Margin="0,2,0,2"/>
            <Button Content="Drone of Downfall (50 Gold)" Click="SpawnTower3_Click" Margin="0,2,0,0"/>
            <Separator Margin="0,6,0,6"/>
            <!-- Button zum Platzieren -->
            <Button Content="Platzieren"
            Click="PlaceTower_Click"
            Background="LimeGreen"
            Foreground="Black"
            FontWeight="Bold"/>
            <Separator Margin="0,6,0,6"/>
            <!--Upgrade Button-->
            <Button x:Name="UpgradeButton" Content="Upgrade (Level 2: 1k Gold, Level 3: 10k Gold" Click="UpgradeButton_Click"/>
            <Separator Margin="0,6,0,6"/>
            <!--Delete Button-->
            <Button Content="Delete"
        Click="DeleteTower_Click"
        Background="IndianRed"
        Foreground="White"/>
            <Separator Margin="0,6,0,6"/>
            <!--Auflistung der auf dem Spielfeld platzierten Türme in einer Listbox-->
            <ListBox x:Name="TowerList"
         Grid.Row="1"
         ItemsSource="{Binding Towers}"
         SelectedItem="{Binding SelectedTower, Mode=TwoWay}"
         Background="#222"
         Foreground="White"
         BorderBrush="#555"
         Margin="10"
         ScrollViewer.VerticalScrollBarVisibility="Auto"
         ScrollViewer.CanContentScroll="True"
         MaxHeight="300">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <!-- Tower image -->
                            <Image Source="{Binding Sprite.Source}" Width="30" Height="30"/>

                            <!-- Tower name -->
                            <TextBlock Text="{Binding Name}" Foreground="White" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            

        </StackPanel>

        <!-- Der StartScreen-->
        <Grid Background="Silver"  Visibility="{Binding IsStartScreen, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Tower Defense" HorizontalAlignment="Center" FontFamily="High Tower Text" FontSize="70" Margin="0,0,0,100"></TextBlock>
                <Button Content="{Binding ContinueLabel}" Click="Continue_Click" FontFamily="High Tower Text" Height="150" Width="500"></Button>
                <TextBlock Text="Klicke auf Spiel Starten um das Spiel zu beginnen." HorizontalAlignment="Center" FontFamily="High Tower Text" FontSize="35"></TextBlock>
            </StackPanel>
        </Grid>
        
        <!-- Der EndScreen-->
        <Grid Background="Silver"  Visibility="{Binding IsEndScreen, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Tower Defense" HorizontalAlignment="Center" FontFamily="High Tower Text" FontSize="70" Margin="0,0,0,30"></TextBlock>
                <TextBlock Text="Game Over" HorizontalAlignment="Center" FontFamily="High Tower Text"  FontSize="90" Margin="0,0,0,30"></TextBlock>
                <StackPanel  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,8">
                    <TextBlock Text="Runden überlebt: " FontFamily="High Tower Text" FontSize="40"/>
                    <!-- Binding: Text zeigt Wert aus GameViewModel.Lives an -->
                    <TextBlock Text="{Binding CurrentWave}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="High Tower Text" FontSize="70" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="{Binding ContinueLabel}" Click="Continue_Click" FontFamily="High Tower Text" Height="150" Width="500"></Button>
                <TextBlock Text="Klicke auf Neustart um das Spiel zu beginnen." FontFamily="High Tower Text" HorizontalAlignment="Center" FontSize="35"></TextBlock>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
